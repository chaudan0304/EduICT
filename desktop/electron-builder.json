{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "vn.edumaster.desktop",
  "productName": "EduMaster",
  "copyright": "EduICT",
  "directories": {
    "app": ".stage/app",
    "output": "../release",
    "buildResources": "build"
  },
  "electronDist": "node_modules/electron/dist",
  "asar": true,
  "asarUnpack": [
    "desktop/native/*.ps1",
    "server/*.ps1",
    "server/*.py"
  ],
  "files": [
    "**/*",
    "!**/*.map",
    "!**/.env",
    "!**/.env.*",
    "!**/*.sqlite",
    "!**/*.sqlite-wal",
    "!**/*.sqlite-shm",
    "!**/*.db",
    "!**/{uploads,backups,settings,locks,tests,docs,scratch,.git}/**"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "compression": "normal",
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "build/EduMaster.ico",
    "artifactName": "EduMaster-Setup.exe",
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createStartMenuShortcut": true,
    "createDesktopShortcut": true,
    "shortcutName": "EduMaster",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "uninstallDisplayName": "EduMaster"
  }
}
