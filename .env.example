# EduICT - Google Gemini AI Assistant Configuration
# Nhập khóa API Google Gemini của bạn dưới đây:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Mô hình Gemini AI khuyến nghị (mặc định: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Bật/tắt tính năng Trợ giảng AI (true/false)
GEMINI_ENABLED=true

# Đường dẫn file SQLite Database (Tùy chọn)
# Mặc định: ./edumaster.sqlite (đã được .gitignore bảo vệ tuyệt đối)
# Để bảo vệ an toàn dữ liệu học sinh thật trên máy giáo viên, hãy trỏ ra ngoài thư mục Git:
# Ví dụ Windows: EDUICT_DB_PATH=C:/Users/chaud/Documents/EduICT/edumaster.sqlite
# EDUICT_DB_PATH=

